<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_dark">
    <TextView android:id="@+id/city" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="LAGOS" android:textColor="#FFFF9500" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFFFF" android:textSize="46sp"
        android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:maxLines="1" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM" android:textColor="#FF8E8E93"
        android:textSize="13sp" android:maxLines="1" />
</LinearLayout>
