<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="16dp" android:background="@drawable/bg_dark">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.42" android:orientation="vertical">
        <TextClock android:id="@+id/weekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="EEEE" android:format24Hour="EEEE" android:textAllCaps="true" android:textColor="#FFFF3B30"
            android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        <TextClock android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="d" android:format24Hour="d" android:textColor="#FFFFFFFF" android:textSize="56sp"
            android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextClock android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format12Hour="MMMM yyyy" android:format24Hour="MMMM yyyy" android:textColor="#FF8E8E93"
            android:textSize="13sp" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:id="@+id/grid" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.58"
        android:scaleType="fitCenter" />
</LinearLayout>
