        </receiver>
        <receiver android:name=".W_search_m" android:label="@string/label_search_m" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_search_m" />
        </receiver>
